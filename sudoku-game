def solve(board):
    """Backtracking solver with MRV heuristic"""
    empties = [(r, c) for r in range(9) for c in range(9) if board[r][c] == 0]
    if not empties:
        return True

    def candidates(r, c):
        used = set()
        for i in range(9):
            used.add(board[r][i])
            used.add(board[i][c])
        br, bc = r // 3 * 3, c // 3 * 3
        for i in range(3):
            for j in range(3):
                used.add(board[br + i][bc + j])
        return [n for n in range(1, 10) if n not in used]

    # MRV: pick the empty cell with the fewest candidates
    best_cell, best_cands = None, None
    for (r, c) in empties:
        cands = candidates(r, c)
        if not cands:
            return False  # dead end, backtrack immediately
        if best_cands is None or len(cands) < len(best_cands):
            best_cell, best_cands = (r, c), cands
            if len(cands) == 1:
                break  # can't do better than 1 candidate

    r, c = best_cell
    for n in best_cands:
        board[r][c] = n
        if solve(board):
            return True
        board[r][c] = 0
    return False

def parse(puzzle_text):
    """
    Parses a beautifully formatted Sudoku grid.
    Ignores spaces, dashes, pipes, and empty lines.
    Uses '.' or '0' for empty cells.
    """
    board = []
    for line in puzzle_text.strip().splitlines():
        row = [ch for ch in line if ch.isdigit() or ch == '.']
        if row:
            board.append([int(ch) if ch != '.' else 0 for ch in row[:9]])
    return board

def pretty(board):
    """Prints the board with Sudoku-style separators."""
    for i, row in enumerate(board):
        if i % 3 == 0 and i != 0:
            print("-" * 21)
        print(" ".join(str(x) if x else "." for x in row[:3]) + " | " +
              " ".join(str(x) if x else "." for x in row[3:6]) + " | " +
              " ".join(str(x) if x else "." for x in row[6:]))

# ---------- INPUT ----------
puzzle_text = """
. . 8 | 6 . . | 7 . .
9 . . | . 2 . | . . .
. . . | . . . | 8 . .
------+-------+------
. . . | . 5 . | . 4 6
3 . . | . . . | . 1 .
. . . | . . 9 | . . .
------+-------+------
. 4 6 | 8 . . | . . .
. . . | . . . | 9 . .
. 7 . | . . . | . . .
"""

board = parse(puzzle_text)
print("Original:")
pretty(board)

if solve(board):
    print("\nSolved:")
    pretty(board)
else:
    print("\nNo solution exists.")
